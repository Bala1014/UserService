    "AccessTokenLifetimeMinutes": 15,
    "Algorithm": "RS256",
    "PrivateKeyPem": "",
    "SigningKey": "",
    "KeyId": ""
  },
  "Google": {
    "ClientId": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://raceservice-frontend-dev-dot-racingglazing.de.r.appspot.com"
    ]
  }
